# ==============================================================================
# HYPERON-DEX ENTERPRISE CONFIGURATION (.env.example)
# Production-Ready Decentralized Exchange Aggregator & Institutional Terminal
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Application Environment: 'development' | 'production' | 'test'
# In production, strict fail-closed security guards are activated (e.g., mandatory
# WEBHOOK_SECRET, distributed nonce/lottery stores, strict CORS, and rate limiting).
NODE_ENV=development

# Server Port (Defaults to 3000 for container ingress routing)
PORT=3000

# Canonical Application Hosting URL
# Used for self-referential links, SIWE authentication domain matching, and CORS origin validation.
# In Cloud Run / container deployments, this is automatically injected.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. WEBHOOK SECURITY & SSRF PROTECTION (CVE-2026-63730)
# ------------------------------------------------------------------------------
# HMAC-SHA256 Signing Secret for Outbound Institutional Webhooks
# MANDATORY in production (NODE_ENV=production). If missing in production, webhook
# dispatch throws an explicit security exception to prevent unsigned payload spoofing.
WEBHOOK_SECRET=""

# Comma-separated list of additional trusted external webhook destination hostnames.
# Defaults already whitelist: api.hyperon.io, webhook.trusted.com, hooks.slack.com, discord.com, api.telegram.org, api.pagerduty.com.
# Only HTTPS scheme and standard port 443 are permitted. Private/internal IPs are strictly blocked.
ALLOWED_WEBHOOK_DOMAINS="api.hyperon.io,webhook.trusted.com"

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED PERSISTENCE & MULTI-CONTAINER CLUSTER (PRODUCTION)
# ------------------------------------------------------------------------------
# In multi-container production environments, distributed storage is required for:
# - Single-use SIWE & EIP-712 nonce replay prevention (DistributedNonceStore)
# - Provably fair lottery state synchronization & winner settlement (DistributedLotteryStore)
# If both REDIS_URL and DATABASE_URL are absent in production, state stores fail closed (503).
# In development/test, durable local file persistence (.data/) is utilized automatically.

# Redis Connection URL (e.g., redis://user:password@redis-cluster:6379 or Upstash REST URL)
REDIS_URL=""
# Optional bearer token when utilizing HTTP-based Upstash Redis endpoints
REDIS_TOKEN=""

# PostgreSQL Connection URL (Alternative to Redis for multi-instance state persistence)
DATABASE_URL=""
POSTGRES_URL=""

# Optional flag to enforce distributed store validation in staging/development environments
REQUIRE_DISTRIBUTED_NONCE_STORE=false
REQUIRE_DISTRIBUTED_LOTTERY_STORE=false

# ------------------------------------------------------------------------------
# 5. ENTERPRISE BLOCKCHAIN RPC ENDPOINTS (MULTI-CHAIN)
# ------------------------------------------------------------------------------
# Comma-separated RPC provider URLs (e.g., Alchemy, Infura, QuickNode, Private Validator Nodes).
# If configured, custom endpoints are prepended to the resilient Viem fallback transport.
# If omitted, canonical high-availability public endpoints are used automatically.

ETH_RPC_URLS=""
BASE_RPC_URLS=""
ARBITRUM_RPC_URLS=""
OPTIMISM_RPC_URLS=""
BSC_RPC_URLS=""
POLYGON_RPC_URLS=""

